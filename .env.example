# API (packages/api)
DATABASE_URL=postgresql://user:password@localhost:5432/vibesafe
REDIS_URL=redis://localhost:6379
# LLM provider: NVIDIA NIM (OpenAI-compatible API). Key from https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-...
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.3-70b-instruct
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
JWT_SECRET=
API_URL=https://vibesafe.dev/api
WEB_URL=https://vibesafe.dev
PORT=3001

# Web (packages/web)
NEXT_PUBLIC_API_URL=https://vibesafe.dev/api
